NODE_ENV=development
PORT=3939
JWT_SECRET=supersecret
JWT_EXPIRATION_MINUTES=10080
# Vercel's MongoDB Atlas integration sets MONGODB_URI instead; either name works.
MONGO_URI=mongodb://mongodb:27017/test
# Comma-separated allowed origins, e.g. https://sharewise.vercel.app. Unset allows all.
CORS_ORIGIN=
# Optional scheduler-only secret; use a long random value in production.
# Copy it to GitHub Actions secret SHAREWISE_DEMO_RESTORE_SECRET.
CRON_SECRET=
